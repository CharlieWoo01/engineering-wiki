---
/** Tag chips linking to each tag's page. */
import { withBase } from '../lib/paths.ts';

interface Props {
  tags: readonly string[];
  /** Optional page count per tag, shown after the name. */
  counts?: ReadonlyMap<string, number>;
  label?: string;
}

const { tags, counts, label = 'Tags' } = Astro.props;
---

{tags.length > 0 && (
  <ul class="tag-links" aria-label={label}>
    {tags.map((tag) => (
      <li>
        <a href={withBase(import.meta.env.BASE_URL, `tags/${tag}/`)}>
          <span aria-hidden="true">#</span>
          {tag}
          {counts?.has(tag) && <span class="tag-links__count">{counts.get(tag)}</span>}
        </a>
      </li>
    ))}
  </ul>
)}

<style>
  .tag-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tag-links li {
    margin: 0;
  }

  .tag-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.125rem 0.625rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-xs);
    text-decoration: none;
  }

  .tag-links a:hover {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-accent-high);
  }

  .tag-links__count {
    padding-inline-start: 0.25rem;
    border-inline-start: 1px solid var(--sl-color-gray-5);
    color: var(--sl-color-gray-3);
  }
</style>
