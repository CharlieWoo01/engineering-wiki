---
/**
 * Starlight override: the default page title, followed by the page's status,
 * owner, review date and reading time, and its tags.
 */
import Default from '@astrojs/starlight/components/PageTitle.astro';
import { Badge, Icon } from '@astrojs/starlight/components';
import TagLinks from './TagLinks.astro';
import { readingMinutes } from '../lib/docs-index.ts';
import { describePageMeta, hasPageMeta, REVIEW_INTERVAL_MONTHS } from '../lib/page-meta.ts';

const { entry } = Astro.locals.starlightRoute;
const meta = describePageMeta(entry.data, new Date());
const minutes = readingMinutes(entry.body);
const showMeta = hasPageMeta(meta) || minutes > 0;
---

<Default />

{showMeta && (
  <ul class="page-meta" aria-label="Page information">
    {meta.status && (
      <li>
        <Badge text={meta.status.label} variant={meta.status.variant} />
      </li>
    )}
    {meta.owner && (
      <li>
        <Icon name="comment-alt" size="1rem" />
        <span>
          Owner: <strong>{meta.owner}</strong>
        </span>
      </li>
    )}
    {meta.lastReviewed && (
      <li>
        <Icon name="approve-check-circle" size="1rem" />
        <span>
          Reviewed <time datetime={meta.lastReviewed.iso}>{meta.lastReviewed.display}</time>
        </span>
        {meta.lastReviewed.overdue && (
          <Badge
            text="Review due"
            variant="caution"
            title={`Not reviewed in the last ${REVIEW_INTERVAL_MONTHS} months`}
          />
        )}
      </li>
    )}
    {minutes > 0 && (
      <li>
        <Icon name="clock" size="1rem" />
        <span>{minutes} min read</span>
      </li>
    )}
  </ul>
)}

{entry.data.tags.length > 0 && (
  <div class="page-tags">
    <TagLinks tags={entry.data.tags} />
  </div>
)}

<style>
  .page-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.25rem;
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }

  .page-meta li {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }

  .page-meta strong {
    color: var(--sl-color-gray-2);
    font-weight: 600;
  }

  .page-tags {
    margin-top: 0.75rem;
  }
</style>
