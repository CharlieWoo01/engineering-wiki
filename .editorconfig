root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.{md,mdx}]
# Trailing double spaces are hard line breaks in Markdown; we prefer explicit
# breaks, so trimming is safe and keeps diffs clean.
trim_trailing_whitespace = true
