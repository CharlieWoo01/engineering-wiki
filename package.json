{
  "name": "engineering-wiki",
  "version": "0.1.0",
  "private": true,
  "description": "Engineering Wiki — documentation-as-code with Astro Starlight.",
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "astro sync && eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:markdown": "markdownlint-cli2",
    "check:links": "astro build && node scripts/check-links.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "validate": "pnpm format:check && pnpm lint && pnpm lint:markdown && pnpm check && pnpm test && pnpm check:links && pnpm test:e2e"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.10",
    "@astrojs/starlight": "^0.43.1",
    "@expressive-code/plugin-line-numbers": "^0.44.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "astro": "^7.4.13",
    "astro-og-canvas": "^0.13.3",
    "canvaskit-wasm": "^0.42.0",
    "mermaid": "^12.3.0",
    "sharp": "^0.35.5",
    "starlight-links-validator": "^0.27.0",
    "starlight-llms-txt": "^0.12.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "markdownlint-cli2": "^0.24.2",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1"
  }
}
